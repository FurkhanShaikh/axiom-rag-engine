# ──────────────────────────────────────────────────────────────────────────────
# Axiom Engine — reference .env template
#
# Copy to `.env` and edit. All AXIOM_* variables are parsed by
# `axiom_rag_engine.config.settings.Settings`. Run `axiom-rag-engine check-config`
# to see the resolved values with their source (env / .env / default).
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Environment tier. Non-development values REQUIRE AXIOM_API_KEYS.
# Valid: production (default), development, dev, local, test
# A development value turns auth off only when no API keys are configured:
# configured keys are always enforced.
# AXIOM_ENV=development

# /docs and /redoc. Unset: on when auth is off, off when auth is required.
# AXIOM_DOCS_ENABLED=true

# ── Authentication ───────────────────────────────────────────────────────────
# Comma-separated API keys. Required when AXIOM_ENV is production.
# AXIOM_API_KEYS=key1,key2,key3
# Keys allowed to ingest/delete corpus documents (the corpus is shared by all
# keys). Also valid API keys. Empty = corpus writes refused when auth is on.
# AXIOM_ADMIN_API_KEYS=adminkey1

# ── Search ───────────────────────────────────────────────────────────────────
# Tavily powers live web retrieval. Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# In non-development environments, live search is required unless you explicitly
# opt into mock retrieval for isolated testing.
# AXIOM_ALLOW_MOCK_SEARCH=false

# Require genuine cross-source corroboration for Tier 2. When true, a multi-domain
# sentence reaches Tier 2 only if >=2 sources independently corroborate its central
# claim (an extra verifier call); otherwise it drops to Tier 3. Default false keeps
# Tier 2 as multi-domain coverage. Fails safe to Tier 3 on any check error.
# AXIOM_CORROBORATION_ENABLED=false

# Detect cross-source contradiction -> Tier 6 (Conflicted). When true, a multi-domain
# sentence whose cited sources actively contradict each other is surfaced as Tier 6
# instead of a confident Tier 1/2 (an extra verifier call). Runs before, and overrides,
# the corroboration gate. Default false = contradiction not checked, Tier 6 never
# assigned. Fails safe: a check error keeps the original tier (asserts no conflict it
# could not verify).
# AXIOM_CONTRADICTION_DETECTION_ENABLED=false

# Enable hybrid retrieval (BM25 + dense embeddings, fused via reciprocal-rank
# fusion). Set to a LiteLLM embedding model to turn it on; empty = BM25-only.
# Dense retrieval helps most on vocabulary-mismatch queries (see BENCHMARKS.md).
# Falls back to BM25 automatically if the embedder is unreachable.
# AXIOM_EMBEDDING_MODEL=ollama/nomic-embed-text     # local, free (ollama pull first)
# AXIOM_EMBEDDING_MODEL=text-embedding-3-small      # hosted, needs OPENAI_API_KEY
# AXIOM_RRF_K=60

# Second-stage reranking (opt-in). Set a LiteLLM chat model to regrade the top
# AXIOM_RERANK_TOP_K candidates (query+passage judged together) and reorder by
# relevance before trimming — lifts precision@k (see BENCHMARKS.md). Unset = off.
# Pick a FAST model: this adds up to AXIOM_RERANK_TOP_K LLM calls per request, and
# a local thinking model adds seconds per candidate. Fails open to the base order.
# AXIOM_RERANKER_MODEL=gpt-4o-mini
# AXIOM_RERANK_TOP_K=20          # must exceed max_ranked_chunks to change the result set

# ── Corpus (bring-your-own documents) ─────────────────────────────────────────
# Set a path to enable the document-management API (POST/GET/DELETE /v1/documents)
# and a single-node SQLite corpus store. Unset (default) = web-only, no corpus.
# AXIOM_CORPUS_DB_PATH=./data/corpus.db

# Where the retriever draws sources from:
#   web    — Tavily live search (default)
#   corpus — only ingested documents
#   both   — merge web + corpus, deduplicated
# 'corpus'/'both' require AXIOM_CORPUS_DB_PATH *and* AXIOM_EMBEDDING_MODEL
# (ingested chunks are embedded at ingest and matched by cosine at query time).
# AXIOM_RETRIEVAL_SOURCE=web

# Top-k chunks corpus retrieval returns per search query.
# AXIOM_CORPUS_MAX_RESULTS=5

# Cap on chunks stored per ingested document (guards a runaway upload).
# AXIOM_CORPUS_MAX_CHUNKS_PER_DOCUMENT=2000
# PDFs are parsed in a child process that is killed on overrun.
# AXIOM_CORPUS_MAX_PDF_PAGES=500
# AXIOM_CORPUS_PDF_TIMEOUT_SECONDS=60

# Body-size cap for the document-ingest endpoints (bytes). Separate from
# AXIOM_MAX_BODY_BYTES so the synthesize API stays tight while documents can be
# large. Default 10 MiB.
# AXIOM_MAX_DOCUMENT_BYTES=10485760

# Verify citations against full page text instead of the search snippet. Snippets
# are summaries, so a quote that genuinely exists on the page can be missing from
# one and get marked Tier 5 (hallucinated). Set false to trade that accuracy for
# lower retrieval latency.
# AXIOM_FETCH_FULL_PAGES=true

# Timeout for one web search request; failures are retried twice.
# AXIOM_SEARCH_TIMEOUT_SECONDS=20

# Per-document cap on full page text; oversized pages are truncated, not dropped.
# AXIOM_MAX_RAW_CONTENT_CHARS=200000

# ── LLM: Local (Ollama) — free, no API cost ──────────────────────────────────
# Install Ollama: https://ollama.com  then  ollama pull qwen3.5:9b
# Specify per-request:
#   "models": { "synthesizer": "ollama/qwen3.5:9b", "verifier": "ollama/qwen3.5:9b" }
OLLAMA_API_BASE=http://localhost:11434

# ── LLM: Cloud ───────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # for claude-opus-4-8
# OPENAI_API_KEY=your_openai_api_key_here          # for gpt-4o-mini
# OPENROUTER_API_KEY=your_openrouter_api_key_here  # one key for many providers
# With only an OpenRouter key, startup selects these (any openrouter/<vendor>/<model>):
# AXIOM_OPENROUTER_SYNTHESIZER_MODEL=openrouter/openai/gpt-4o
# AXIOM_OPENROUTER_VERIFIER_MODEL=openrouter/openai/gpt-4o-mini

# Default model IDs when not specified in the request body.
# AXIOM_DEFAULT_SYNTHESIZER_MODEL=claude-opus-4-8
# AXIOM_DEFAULT_VERIFIER_MODEL=gpt-4o-mini

# When auth is required, callers cannot choose the verifier (it grants the
# tiers), and may choose only the default synthesizer or one listed here.
# AXIOM_ALLOWED_SYNTHESIZER_MODELS=claude-sonnet-5,gpt-4o

# ── LLM budget & concurrency ─────────────────────────────────────────────────
# Hard caps per request (protect wallet + tail latency).
# AXIOM_MAX_LLM_CALLS_PER_REQUEST=64
# AXIOM_MAX_TOKENS_PER_REQUEST=0               # 0 = unlimited
# AXIOM_MAX_CONCURRENT_LLM=5                   # in-flight synthesis calls (process-wide)
# AXIOM_MAX_CONCURRENT_VERIFIER_LLM=           # verification pool; unset = same as above
# Retries for transient provider failures (rate limit, timeout, 5xx); one
# budget unit per call regardless of retries.
# AXIOM_LLM_MAX_RETRIES=2
# AXIOM_LLM_TIMEOUT_SECONDS=120                # raise for slow local models
# AXIOM_REQUEST_DEADLINE_SECONDS=300           # per pipeline run; 0 = none
# AXIOM_LLM_RETRY_MAX_WAIT_SECONDS=8           # also caps Retry-After

# Prometheus label allowlist for the `model` dimension (bounds cardinality).
# AXIOM_ALLOWED_METRIC_MODELS=claude-opus-4-8,gpt-4o-mini,ollama

# ── Rate limiting & response cache ───────────────────────────────────────────
# Default: 20 requests per minute per API key (or IP for unauthenticated).
# AXIOM_RATE_LIMIT=20/minute
# AXIOM_CACHE_TTL_SECONDS=300
# AXIOM_CACHE_MAX_SIZE=256
# Optional Redis for multi-worker deployments.
# AXIOM_REDIS_URL=redis://localhost:6379/0

# ── Verification policy ──────────────────────────────────────────────────────
# Server-enforced. Callers cannot override these via the request body.
# AXIOM_SEMANTIC_VERIFICATION_ENABLED=true
# AXIOM_MIN_USABLE_RANKING_SCORE=0.15
# AXIOM_AUTHORITATIVE_DOMAINS=internal.example.com
# AXIOM_LOW_QUALITY_DOMAINS=blogs.example.com
# AXIOM_EXCLUDE_DEFAULT_DOMAINS=en.wikipedia.org

# ── Security & limits ────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Empty = reject cross-origin requests.
# AXIOM_CORS_ORIGINS=https://your-frontend.example.com

# Only trust X-Forwarded-For when the immediate caller is in this allowlist.
# Use "*" ONLY behind a trusted private ingress.
# AXIOM_TRUSTED_PROXY_IPS=10.0.0.10,10.0.0.11

# Hard cap on request body size in bytes (default 128 KiB).
# AXIOM_MAX_BODY_BYTES=131072

# ── Audit & logging ──────────────────────────────────────────────────────────
# In-memory retention of the last N audit trails, fetched via
# `GET /v1/audits/{request_id}` or `axiom-rag-engine audit <request_id>`.
# 0 (the code default) disables retention. This template sets 200 so the UI's
# Audit Log page works out of the box; lower or zero it in memory-constrained
# production. Trails are scoped to the API key that produced them.
AXIOM_AUDIT_RETENTION=200

# When true, every audit event is also emitted as a structured log line
# (best combined with LOG_FORMAT=json for log-aggregator ingestion).
# AXIOM_LOG_AUDIT_EVENTS=false

# ── Observability ────────────────────────────────────────────────────────────
# Log format: "text" (default, human-readable) or "json" (structured).
# LOG_FORMAT=text

# OpenTelemetry: set OTLP endpoint to enable distributed tracing.
# When unset, tracing is disabled (zero overhead).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=axiom-rag-engine
